# =============================================================
#  ALTACADE LMS — FRONTEND ENVIRONMENT VARIABLES (Vite)
#  Vite only exposes variables prefixed with VITE_ to the browser.
#  NEVER commit this file with real values to git.
# =============================================================

# -----------------------------------------------------------------
# 🔵  GOOGLE OAUTH  (Social login — "Sign in with Google" button)
# -----------------------------------------------------------------
# This is the SAME Client ID you set in Backend/.env as GOOGLE_CLIENT_ID.
# The frontend sends the Google credential token to the backend to verify.
#
# How to get it:
#   1. Go to https://console.cloud.google.com/
#   2. APIs & Services → Credentials → your OAuth 2.0 Client ID
#   3. Copy the Client ID (ends in .apps.googleusercontent.com)
#
# ESSENTIAL: without this, the "Sign in with Google" button will not
# initialize and will throw a GoogleOAuthProvider error.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

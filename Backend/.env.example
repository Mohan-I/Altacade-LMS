# =============================================================
#  ALTACADE LMS — BACKEND ENVIRONMENT VARIABLES
#  Copy this file and fill in your actual values.
#  NEVER commit the filled .env to git.
# =============================================================

# -----------------------------------------------------------------
# 🗄️  DATABASE
# -----------------------------------------------------------------
# Your MongoDB connection string.
# Free tier → https://cloud.mongodb.com → New Project → Build a Cluster
# After creating a cluster: Connect → Drivers → copy the URI.
# Replace <username>, <password>, and <dbname> with your values.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 🔐  JWT (JSON Web Token)
# -----------------------------------------------------------------
# A long, random secret used to sign and verify auth tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ESSENTIAL: without this, no login or protected route will work.
JWT_SECRET=your_super_secret_jwt_key_at_least_64_chars_long

# -----------------------------------------------------------------
# 🚀  SERVER
# -----------------------------------------------------------------
# The port the Express server will listen on.
# Default is 5000 if not set. Keep it at 5000 to match the Vite proxy.
PORT=5000

# Set to "development" locally. Changing to "production" enables
# the Secure flag on cookies (HTTPS only).
NODE_ENV=development

# -----------------------------------------------------------------
# 🌐  URLS
# -----------------------------------------------------------------
# Full public URL of THIS backend server (used for building image URLs
# that are sent to the Gemini AI vision model).
# Locally this is always: http://localhost:5000
BASE_URL=http://localhost:5000

# Full URL of the React frontend (used in welcome email "Get Started" button).
# Vite dev server default: http://localhost:5173
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------
# 🔵  GOOGLE OAUTH  (Social login — student & tutor)
# -----------------------------------------------------------------
# How to get it:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or select existing)
#   3. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#   4. Application type: Web application
#   5. Authorized JavaScript origins: http://localhost:5173
#   6. Authorized redirect URIs: http://localhost:5173 (Vite handles the redirect)
#   7. Copy the CLIENT ID — the same value goes into Frontend/.env as VITE_GOOGLE_CLIENT_ID
#
# This is used on the backend to verify the Google ID token that the
# frontend sends after the user clicks "Sign in with Google".
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# -----------------------------------------------------------------
# 🤖  GOOGLE GEMINI AI  (AI Study Assistant)
# -----------------------------------------------------------------
# Powers the /api/gemini chat and image-chat routes (gemini-2.5-flash model).
# ESSENTIAL for the Ask AI feature to work.
#
# How to get it:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API key" → choose your Google Cloud project
#   3. Copy the key
#
# Free tier is generous (15 req/min, 1M tokens/day as of 2025).
GOOGLE_AI_API_KEY=AIzaSy_your_google_ai_api_key_here

# -----------------------------------------------------------------
# 📧  RESEND  (Transactional Email — welcome emails)
# -----------------------------------------------------------------
# Powers the welcome email sent on registration.
# Not essential for core features — app works without it.
#
# How to get it:
#   1. Sign up at https://resend.com
#   2. Dashboard → API Keys → Create API Key
#   3. Verify your sending domain (or use resend's sandbox for testing)
#
# NOTE: The "from" address in mailer.js is hardcoded to no-reply@oyo.plus
# You must change that to a domain you have verified in Resend, OR
# use Resend's default onboarding@resend.dev for testing (no domain needed).
RESEND_API_KEY=re_your_resend_api_key_here

# -----------------------------------------------------------------
# 📱  WHATSAPP — Meta Business API  (optional notifications)
# -----------------------------------------------------------------
# Used by sendWhatsAppMessage() in utils/whatappWati.js.
# Currently commented-out in auth.js — only enable when you have
# a verified Meta WhatsApp Business account.
#
# How to get it:
#   1. Go to https://developers.facebook.com/
#   2. Create an App → Business → WhatsApp
#   3. WhatsApp → API Setup → copy the temporary or permanent token
#   4. Copy the Phone Number ID shown on the same page
#
# Token — a permanent System User token or a temporary test token
WHATSAPP_TOKEN=EAAxxxxxxxxx_your_meta_access_token

# The numeric Phone Number ID (NOT the phone number itself)
# Found in: Meta Developer Console → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Base URL of the WhatsApp Cloud API (do not change unless Meta changes it)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# -----------------------------------------------------------------
# 📲  WATI  (WhatsApp via WATI — alternative to Meta direct API)
# -----------------------------------------------------------------
# Used by sendWatiTemplateMessage() in utils/whatappWati.js.
# Template "welcome_wati_v1" must be created and approved in your WATI account.
# Currently commented-out in auth.js — only enable when WATI account is ready.
#
# How to get it:
#   1. Sign up at https://www.wati.io/
#   2. Dashboard → Settings → API → copy your API token
#   3. Your base URL is shown in the WATI dashboard (e.g. https://live-server-12345.wati.io)
#
WATI_BASE_URL=https://live-server-XXXXX.wati.io
WATI_API_TOKEN=your_wati_api_token_here
